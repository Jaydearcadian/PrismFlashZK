{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "diagnose": "bash check_toolchain.sh",
    "dashboard": "node live_dashboard.js",
    "provision-wallets": "node generate_wallets.js",
    "orchestrate": "bash deploy_and_run_all.sh",
    "solver-daemon": "tsx solver_daemon_controller.ts",
    "create-tokens": "node create_tokens.js",
    "create-multivm-token": "node scripts/create_multivm_token.js",
    "compile-circuit": "node scripts/compile_circuit.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aztec/bb.js": "^5.0.0-nightly.20260522",
    "@google/genai": "^2.4.0",
    "@noir-lang/noir_js": "^1.0.0-beta.22",
    "@noir-lang/noir_wasm": "^1.0.0-beta.22",
    "@stellar/wallet-sdk": "^0.11.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tweetnacl": "^1.0.3",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@aptos-labs/ts-sdk": "^7.1.3",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@stellar/stellar-sdk": "^16.0.1",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "ethers": "^6.17.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
